// ==UserScript==
// @name         Painel de Bordo Addon - Resumo de Polos
// @namespace    marco.guedes.e259671
// @version      3.2.1
// @description  Cria cards de resumo quantitativo de serviços por município (Tela Local) e por tipo (Tela COD) para SJ e LF (Compatível com DataTables 3).
// @author       Marco Guedes
// @match        *https://geo.cemig.com.br/painel_de_bordo/Geo/Clientes*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    const ADDON_CONFIG = {
        codTypes: ['RC09', 'RC08', 'RC11', 'NSRI', 'MA']
    };

    function injectAddonStyles() {
        if (document.getElementById('re-addon-resumo-styles')) return;
        const style = document.createElement('style');
        style.id = 're-addon-resumo-styles';
        style.textContent = `
            #re-addon-section { padding: 8px 16px 24px 16px; background-color: var(--re-bg-base, #18191a); }
            .re-addon-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid #3a3b3c; }
            .re-addon-title { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #b0b3b8; }
            #addon-resumo-area { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; width: 100%; }
            .addon-card-wrapper { background-color: #ffffff; border: 1px solid #d1d5db; border-radius: 6px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
            .addon-card-top { display: flex; align-items: center; justify-content: space-between; background-color: #f3f4f6; padding: 6px 12px; border-bottom: 1px solid #e5e7eb; font-size: 11px; font-weight: 700; color: #374151; text-transform: uppercase; }
            .addon-info-card { background-color: #ffffff !important; color: #111827 !important; border: none !important; margin: 0 !important; padding: 12px !important; font-family: 'Consolas', 'Courier New', monospace !important; font-size: 12px !important; line-height: 1.45 !important; white-space: pre-wrap !important; flex: 1; }
            .addon-card-footer { display: flex; align-items: center; justify-content: flex-end; padding: 6px 10px; background-color: #f9fafb; border-top: 1px solid #e5e7eb; }
            .addon-copy-button { background-color: #1a73e8 !important; color: #ffffff !important; border: none !important; border-radius: 4px !important; padding: 5px 12px !important; font-size: 11px !important; font-weight: 600 !important; letter-spacing: 0.4px; text-transform: uppercase; cursor: pointer; transition: background-color 0.15s ease; }
            .addon-copy-button:hover { background-color: #1557b0 !important; }
            .addon-copy-button.copied { background-color: #16a34a !important; }
        `;
        document.head.appendChild(style);
    }

    function ensureContainerExists() {
        if ($('#re-addon-section').length) return $('#addon-resumo-area');
        const $section = $(`<div id="re-addon-section"><div class="re-addon-header"><span class="re-addon-title">Resumo Quantitativo por Polo (Tela Local & Tela COD)</span></div><div id="addon-resumo-area"></div></div>`);

        if ($('#re-cards-section').length) {
            $('#re-cards-section').after($section);
        } else {
            const $tableWrapper = $('#tabela-de-dados-clientes_wrapper, .dt-container, .dataTables_wrapper').first();
            if ($tableWrapper.length) $tableWrapper.parent().after($section);
            else $('body').append($section);
        }
        return $('#addon-resumo-area');
    }

    function createSummaryCard(poloLabel, text, $container) {
        const $wrapper = $(`<div class="addon-card-wrapper"><div class="addon-card-top"><span>Resumo Operacional — ${poloLabel}</span></div><pre class="addon-info-card"></pre><div class="addon-card-footer"><button type="button" class="addon-copy-button">COPIAR</button></div></div>`);
        $wrapper.find('pre.addon-info-card').text(text);
        $wrapper.find('.addon-copy-button').on('click', function() {
            const $btn = $(this);
            navigator.clipboard.writeText(text.trim()).then(() => {
                $btn.text('COPIADO').addClass('copied').prop('disabled', true);
                setTimeout(() => $btn.text('COPIAR').removeClass('copied').prop('disabled', false), 1800);
            });
        });
        $container.append($wrapper);
    }

    function renderPoloSummaries(servicesList) {
        injectAddonStyles();
        const $addonArea = ensureContainerExists().empty();

        const sjLocalCities = {}; const lfLocalCities = {};
        const sjCodCounts = {}; const lfCodCounts = {};
        let sjLocalTotal = 0; let lfLocalTotal = 0;
        let sjCodTotal = 0; let lfCodTotal = 0;

        servicesList.forEach(ad => {
            const tip = (ad.tipS || 'MA').toUpperCase().trim();
            const mun = (ad.mun || 'N/A').toUpperCase().trim();
            const isCOD = ADDON_CONFIG.codTypes.includes(tip);

            if (ad.poloGroup === 'SJ') {
                if (isCOD) { sjCodCounts[tip] = (sjCodCounts[tip] || 0) + 1; sjCodTotal++; }
                else { sjLocalCities[mun] = (sjLocalCities[mun] || 0) + 1; sjLocalTotal++; }
            } else if (ad.poloGroup === 'LF') {
                if (isCOD) { lfCodCounts[tip] = (lfCodCounts[tip] || 0) + 1; lfCodTotal++; }
                else { lfLocalCities[mun] = (lfLocalCities[mun] || 0) + 1; lfLocalTotal++; }
            }
        });

        let sjText = `*❗${sjLocalTotal} EMERGENCIAIS NA TELA DE SJ:❗*\n\n`;
        Object.keys(sjLocalCities).sort((a, b) => sjLocalCities[b] - sjLocalCities[a]).forEach(city => { sjText += `- ${sjLocalCities[city]} em ${city}\n`; });
        sjText += `\n*‼️${sjCodTotal} EMERGENCIAIS NA TELA DO COD.‼️*\n\n`;
        Object.keys(sjCodCounts).forEach(tip => { sjText += `- ${sjCodCounts[tip]} ${tip === 'MA' ? 'Manobras' : tip}\n`; });
        sjText += `\n*❕Comerciais em tela*: 0 || *Vencendo*: 0❕\n\n`;
        createSummaryCard('Polo São João (SJ)', sjText, $addonArea);

        let lfText = `*❗${lfLocalTotal} EMERGENCIAIS NA TELA DE LF:❗*\n\n`;
        Object.keys(lfLocalCities).sort((a, b) => lfLocalCities[b] - lfLocalCities[a]).forEach(city => { lfText += `- ${lfLocalCities[city]} em ${city}\n`; });
        lfText += `\n*‼️${lfCodTotal} EMERGENCIAIS NA TELA DO COD.‼️*\n\n`;
        Object.keys(lfCodCounts).forEach(tip => { lfText += `- ${lfCodCounts[tip]} ${tip === 'MA' ? 'Manobras' : tip}\n`; });
        lfText += `\n*❕Comerciais em tela*: 0 || *Vencendo*: 0❕\n\n`;
        createSummaryCard('Polo Lafaiete (LF)', lfText, $addonArea);
    }

    window.addEventListener('RealEnergy:DataProcessed', function(event) {
        if (event && event.detail && Array.isArray(event.detail.services)) {
            renderPoloSummaries(event.detail.services);
        }
    });

})();
